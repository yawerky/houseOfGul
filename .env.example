# Database (SQLite - local file)
DATABASE_URL="file:./dev.db"

# Admin Authentication
JWT_SECRET="your-secure-random-string-min-32-characters"

# Site URL (your domain)
NEXT_PUBLIC_SITE_URL="https://houseofgul.in"

# Razorpay (online payments). Leave empty to offer "Pay on delivery" only.
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Image uploads in admin (Vercel → Storage → Blob, connect to project; this is added automatically)
BLOB_READ_WRITE_TOKEN=

# Order emails via Resend (https://resend.com). Leave empty to skip emails.
RESEND_API_KEY=
# Sender on your verified domain, e.g. House of Gul <orders@houseofgul.in>
EMAIL_FROM=
# Where new-order alerts go (defaults to Store Email in Admin → Settings)
ORDER_ALERT_EMAIL=
